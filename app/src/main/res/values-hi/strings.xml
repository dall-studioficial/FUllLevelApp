    <string name="guide_mini_dial">मिनी डायल की सुई को चलते देखें</string>
    <string name="guide_welcome_title">Full Level में आपका स्वागत है</string>
    <string name="guide_welcome_body">ढलान मापने, सतहों को सही करने और पूरे भरोसे के साथ काम करने के लिए एक सटीक क्लिनोमीटर।</string>
    <string name="guide_level_title">हर बदलाव को देखें</string>
    <string name="guide_level_body">फ़ोन को धीरे-धीरे झुकाएँ। मिनी डायल की सुई को चलते देखें और लाइव रीडिंग से उसकी तुलना करें। भरोसेमंद माप के लिए डिवाइस को स्थिर रखें।</string>
    <string name="guide_modes_title">मापने का तरीका चुनें</string>
    <string name="guide_modes_body">डिग्री कोण दिखाती हैं। Pitch, हर 12 इकाई की क्षैतिज दूरी पर ऊर्ध्वाधर बढ़त के रूप में ढलान बताता है।</string>
    <string name="guide_reference_title">अपना संदर्भ चुनें</string>
    <string name="guide_reference_body">क्षैतिज या ऊर्ध्वाधर काम के लिए 0° और 90° संदर्भ बदलें। अधिक सटीकता के लिए किसी ज्ञात समतल सतह पर कैलिब्रेट करें।</string>
    <string name="guide_tools_title">माप को अपने पास रखें</string>
    <string name="guide_tools_body">रीडिंग की समीक्षा करने के लिए उसे स्थिर करें, या लाइव लेवल ओवरले के साथ सतह को सही करने के लिए कैमरा खोलें।</string>
    <string name="guide_ready_title">अब आप तैयार हैं</string>
    <string name="guide_ready_body">शुरू करने के लिए बस इतना ही। आप इस मार्गदर्शिका को सेटिंग्स से कभी भी फिर से खोल सकते हैं।</string>
